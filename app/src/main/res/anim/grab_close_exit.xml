<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen on top drops away. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/grab_exit">
    <alpha
        android:duration="@integer/dur_fast"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
    <translate
        android:duration="@integer/dur_fast"
        android:fromYDelta="0"
        android:toYDelta="7%p" />
</set>
