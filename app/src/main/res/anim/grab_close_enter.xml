<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen underneath grows the last bit forward. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/grab_enter">
    <alpha
        android:duration="@integer/dur_normal"
        android:fromAlpha="0.6"
        android:toAlpha="1.0" />
    <scale
        android:duration="@integer/dur_normal"
        android:fromXScale="1.04"
        android:fromYScale="1.04"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
</set>
