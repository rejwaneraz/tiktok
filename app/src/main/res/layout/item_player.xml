<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/pRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="118dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="54dp">

            <ImageView
                android:id="@+id/pAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/rail_avatar_ring"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/avatar_ring" />

            <ImageView
                android:id="@+id/pFollow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/dot_accent"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_add" />
        </FrameLayout>

        <ImageView
            android:id="@+id/pLike"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_heart" />

        <TextView
            android:id="@+id/pLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/pComment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_comment" />

        <TextView
            android:id="@+id/pCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/pMark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_download" />

        <TextView
            android:id="@+id/pMarkCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/pShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_share" />

        <TextView
            android:id="@+id/pShareCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/pauseIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/play_bg"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/on_video"
        android:textSize="22sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:max="100"
        android:progressTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="86dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video_muted"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
