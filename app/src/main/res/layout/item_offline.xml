<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offlinePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <VideoView
        android:id="@+id/localVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/localPause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/play_bg"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/on_video"
        android:textSize="22sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/localBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:max="100"
        android:progressTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bottom_scrim"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="26dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/localAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/localCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/localMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/see_more"
            android:textColor="@color/on_video"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video_muted"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
