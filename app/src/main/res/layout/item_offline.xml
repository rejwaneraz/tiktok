<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offlinePage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <VideoView
        android:id="@+id/localVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/localPause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/play_bg"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/on_video"
        android:textSize="22sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/localBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:max="100"
        android:progressTint="@color/on_video" />

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="74dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="54dp">

            <ImageView
                android:id="@+id/railAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/rail_avatar_ring"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/avatar_ring" />

            <ImageView
                android:id="@+id/railFollow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/dot_accent"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_add" />
        </FrameLayout>

        <ImageView
            android:id="@+id/railLike"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_heart" />

        <TextView
            android:id="@+id/railLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/railComment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_comment" />

        <TextView
            android:id="@+id/railCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/railMark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_bookmark" />

        <TextView
            android:id="@+id/railMarkCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/railShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/rail_share" />

        <TextView
            android:id="@+id/railShareCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_scrim"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="26dp"
        android:paddingEnd="76dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/localAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/localCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/localMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/see_more"
            android:textColor="@color/on_video"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/localSound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="marquee"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:singleLine="true"
            android:textColor="@color/on_video"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/localMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:textColor="@color/on_video_muted"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
