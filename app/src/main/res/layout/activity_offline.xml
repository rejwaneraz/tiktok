<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/offlinePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/offlineCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/badge_bg"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:textColor="@color/text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/offlineClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/play_bg"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/text"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:id="@+id/offlineChipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="54dp"
        android:background="@drawable/top_scrim"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/offlineChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/offlineEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/offline_empty"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
